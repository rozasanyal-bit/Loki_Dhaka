rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isSignedIn(){return request.auth!=null;}
  function uid(){return request.auth.uid;}
  function callerRole(){return get(/databases/$(database)/documents/users/$(uid())).data.role;}
  function isOwner(){return isSignedIn()&&callerRole()=="owner";}
  function isStaff(){return isSignedIn()&&(callerRole()=="staff"||callerRole()=="owner");}
  function isPrivileged(){return isSignedIn()&&(callerRole() in ["staff","owner","developer"]);}
  match /publicProfiles/{userId} {
   allow read: if (isSignedIn()&&uid()==userId)||isPrivileged();
   allow create: if isSignedIn()&&uid()==userId&&request.resource.data.qrCode==uid()
     && get(/databases/$(database)/documents/users/$(uid())).data.role == request.resource.data.role;
   allow update: if isSignedIn()&&uid()==userId&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role","qrCode","email","createdAt"]);
   allow create,update: if isOwner(); allow delete: if isOwner();
  }
  match /users/{userId} {
   allow read: if isPrivileged();
   allow create: if isSignedIn()&&uid()==userId&&(request.resource.data.role=="customer"||(request.resource.data.role=="staff"&&request.resource.data.get("approved",false)==false));
   allow update: if isSignedIn()&&uid()==userId&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role","qrCode","email","status","createdAt","approved"]);
   allow update: if isStaff()&&!request.resource.data.diff(resource.data).affectedKeys().hasAny(["role","qrCode","email","createdAt"]);
   allow update: if isOwner(); allow delete: if isOwner();
  }
  match /visits/{visitId} {
   allow read: if isPrivileged();
   allow create: if isStaff()&&request.resource.data.staffId==uid()&&request.resource.data.userId is string&&request.resource.data.date is string;
   allow update,delete: if isOwner();
  }
  match /staffInvites/{token} {
   allow read: if isOwner()||(resource.data.active==true&&resource.data.expiresAt>request.time&&resource.data.uses<resource.data.maxUses);
   allow create: if isOwner()&&request.resource.data.createdBy==uid();
   allow update,delete: if isOwner();
   allow update: if resource.data.active == true && resource.data.expiresAt > request.time && resource.data.uses < resource.data.maxUses
     && request.resource.data.createdBy == resource.data.createdBy
     && request.resource.data.maxUses == resource.data.maxUses
     && request.resource.data.uses == resource.data.uses + 1
     && request.resource.data.active == (resource.data.uses + 1 < resource.data.maxUses);
  }
 }
}
