{
  "name": "@workspace/loki-bar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cap:add:android": "pnpm exec cap add android",
    "cap:add:ios": "pnpm exec cap add ios",
    "cap:sync": "pnpm exec cap sync",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:doctor": "pnpm exec cap doctor",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew bundleRelease",
    "export": "next build",
    "build:mobile": "pnpm run build && pnpm run cap:sync",
    "mobile:prepare": "pnpm build && pnpm exec cap sync",
    "hosting:deploy": "pnpm run build && pnpm dlx firebase-tools deploy --only hosting --project loki-portal-final",
    "test:rules": "node --test tests/firestore.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.9.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "@capacitor/push-notifications": "^8.0.2",
    "@capacitor/barcode-scanner": "^3.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.5.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "firebase-admin": "^13.0.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw",
      "sharp"
    ]
  },
  "description": "Loki Bar \u2014 private hospitality portal for Owner, Staff and Customer."
}
